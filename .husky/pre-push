#!/bin/bash
[ -f "$(dirname "$0")/_/husky.sh" ] && . "$(dirname "$0")/_/husky.sh"

# =============================================================================
# Pre-push guard: never push commercially licensed paths or secret material.
#
# What was here before, and why it was replaced (RM-05):
#
# This hook was inherited from upstream. It ran on every push, but its body was
# wrapped in a test for whether the push URL matched `FlowiseAI/Flowise` -- which
# is never true in this fork. Inside that dead branch it blocked `extensions/`
# and `apps/*`, neither of which exists in this repository. So it executed on
# every push, checked nothing, exited 0, and appeared in the hook list as though
# pushes were guarded. A control that cannot fail is worse than no control,
# because it is counted as one (PROCESS-GAPS G1).
#
# It now guards what this repository actually cares about, on every push,
# regardless of remote.
# =============================================================================

set -uo pipefail

remote="${1:-}"
url="${2:-}"

# Paths under FlowiseAI's Commercial License. Deletion is permitted and is the
# goal; adding or modifying them is not. See docs/CLEANROOM-PROTOCOL.md.
LICENSED='^packages/server/src/(enterprise/|IdentityManager\.ts)'

# Secret-shaped files. .gitignore should already stop these, but .gitignore only
# protects git's index -- a file force-added with `git add -f` reaches a commit,
# and this is the last check before it leaves the machine. See RM-16.
SECRETS='(credentials-backup|\.sqlite3?$|(^|/)\.env$|\.pem$|\.p12$|id_rsa$|service-account.*\.json$)'

fail=0

while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue

    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
        base=$(git merge-base "$local_sha" "$remote/main" 2>/dev/null \
            || git merge-base "$local_sha" "$remote/apache2-only" 2>/dev/null || echo "")
        if [ -n "$base" ]; then
            files=$(git diff --name-only "$base..$local_sha")
        else
            files=$(git log --name-only --pretty=format: "$local_sha" | sort -u)
        fi
    else
        files=$(git diff --name-only "$remote_sha..$local_sha")
    fi

    # Licensed paths: additions and modifications only. A deletion is the goal.
    added_or_modified=$(git diff --name-status "${remote_sha:-$base}..$local_sha" 2>/dev/null \
        | awk '$1 != "D" { print $2 }' || echo "$files")
    lic=$(echo "$added_or_modified" | grep -E "$LICENSED" || true)
    if [ -n "$lic" ]; then
        echo "" >&2
        echo "  ✗ PUSH REJECTED — commercially licensed paths" >&2
        echo "$lic" | sed 's/^/      /' >&2
        echo "  Deleting these is permitted; adding or modifying them is not." >&2
        echo "  See docs/CLEANROOM-PROTOCOL.md" >&2
        fail=1
    fi

    sec=$(echo "$files" | grep -EI "$SECRETS" || true)
    if [ -n "$sec" ]; then
        echo "" >&2
        echo "  ✗ PUSH REJECTED — secret-shaped files" >&2
        echo "$sec" | sed 's/^/      /' >&2
        echo "  Never push credential exports, databases, .env files or private keys." >&2
        fail=1
    fi
done

[ "$fail" = "0" ] || exit 1
exit 0
