+        const optionNames = endpointInput.options.map((o: any) => o.name)
+        for (const ep of SERPER_ENDPOINTS) {
+            expect(optionNames).toContain(ep)
+        }
+    })
+
+    it('has all expected optional inputs', () => {
+        const inputNames = node.inputs.map((i: any) => i.name)
