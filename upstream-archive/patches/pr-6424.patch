+++ b/packages/components/credentials/LMStudioApi.credential.ts
@@ -0,0 +1,24 @@
+import { INodeParams, INodeCredential } from '../src/Interface'
+
+class LMStudioApi implements INodeCredential {
+    label: string
+    name: string
+    version: number
+    inputs: INodeParams[]
+
+    constructor() {
+        this.label = 'LM Studio API'
+        this.name = 'lmstudioApi'
+        this.version = 1.0
