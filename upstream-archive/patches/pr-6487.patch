         const obj: Partial<OpenAIChatInput> &
             BaseLLMParams & { openAIApiKey?: string } & { configuration?: { baseURL?: string; defaultHeaders?: ICommonObject } } = {
@@ -125,9 +127,14 @@ class ChatLitellm_ChatModels implements INode {
