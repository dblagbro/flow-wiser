+// Flowise Node Class
+class Crw_DocumentLoaders implements INode {
+    label: string
+    name: string
+    description: string
+    type: string
+    icon: string
+    version: number
+    category: string
+    baseClasses: string[]
+    inputs: INodeParams[]
+    credential: INodeParams
+    outputs: INodeOutputsValue[]
+
+    constructor() {
+        this.label = 'fastCRW'
+        this.name = 'crw'
+        this.type = 'Document'
+        this.icon = 'crw.png'
+        this.version = 1.0
+        this.category = 'Document Loaders'
