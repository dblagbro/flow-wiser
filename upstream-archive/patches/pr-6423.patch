+
+const lines = readFileSync(auditFile, 'utf8').trim().split('\n').filter(Boolean)
+const entries = lines.map((l) => JSON.parse(l))
+
+const stepColors = {
+    session_start: CYAN,
+    session_end: CYAN,
+    propose: DIM,
+    policy_decision: BOLD,
+    hitl: YELLOW,
+    execute: GREEN,
+    observe: DIM
+}
+
+console.log(`\n  ${entries.length} entries written to ${BOLD}${AUDIT_PATH}${RESET}\n`)
+
