--- a/docker/.env.example
+++ b/docker/.env.example
@@ -169,3 +169,4 @@ JWT_REFRESH_TOKEN_EXPIRY_IN_MINUTES=43200
 ############################################################################################################
 # OLLAMA_DEFAULT_BASE_URL=http://host.docker.internal:11434
 # OLLAMA_DEFAULT_MODEL=llama3.2
