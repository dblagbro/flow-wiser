 export const FLOWISE_CREDENTIAL_ID = 'FLOWISE_CREDENTIAL_ID'
 export const REDACTED_CREDENTIAL_VALUE = '_FLOWISE_BLANK_07167752-1a71-43b1-bf8f-4f32252165db'
diff --git a/packages/ui/src/utils/genericHelper.js b/packages/ui/src/utils/genericHelper.js
index 4243f9a433c..9236ba188c0 100644
--- a/packages/ui/src/utils/genericHelper.js
+++ b/packages/ui/src/utils/genericHelper.js
@@ -945,3 +945,19 @@ export const getCustomConditionOutputs = (value, nodeId, existingEdges, isDataGr
 
     return { outputAnchors, toBeRemovedEdgeIds }
 }
+
+export const getBasename = () => {
+    try {
+        const baseTag = document.querySelector('base')
+        let baseHref = !!baseTag ? baseTag.getAttribute('href') || '/' : '/'
+        if (baseHref === '%BASE_HREF%') {
+            baseHref = '/'
+        }
+        if (baseHref.endsWith('/')) {
+            baseHref = baseHref.slice(0, -1)
+        }
+        return baseHref
+    } catch (error) {
+        throw new Error(`basenameHelper.getBasename ${getErrorMessage(error)}`)
+    }
+}
