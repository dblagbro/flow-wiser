+const deleteGitConfig = (id) => client.delete(`/git-config/${id}`)
+
+const activateGitConfig = (id) => client.post(`/git-config/${id}/activate`)
+
+const testGitConfig = (body) => client.post(`/git-config/test`, body)
+
+export default {
+    getAllGitConfigs,
+    getGitConfigById,
+    createGitConfig,
+    updateGitConfig,
+    deleteGitConfig,
+    activateGitConfig,
+    testGitConfig,
+} 
