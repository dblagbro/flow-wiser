+                        <Dropdown
+                            disabled={true}
+                            name='provider'
+                            options={providers}
+                            onSelect={onProviderChange}
+                            value={form.provider}
+                            placeholder='Select a provider'
+                        />
+                    </Box>
+                    <Box sx={{ p: 1 }}>
+                        <Typography>Auth Mode<span style={{ color: 'red' }}>&nbsp;*</span></Typography>
+                        <Dropdown
+                            disabled={true}
