+                    {dialogType === 'ADD' ? 'Add Git Config' : 'Edit Git Config'}
+                </div>
+            </DialogTitle>
+            <form onSubmit={handleSubmit}>
+                <DialogContent>
+                    {renderTestResult()}
+                    <Box sx={{ p: 1 }}>
