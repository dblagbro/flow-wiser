+                            {permissions.permissions?.triage && (
+                                <Chip
+                                    icon={<IconCheck size={12} />}
+                                    label="Triage"
+                                    size="small"
+                                    color="primary"
+                                    variant="outlined"
+                                />
+                            )}
+                        </Box>
+                    </Box>
+                </Alert>
+            )
+        } else {
+            return (
+                <Alert severity="error" sx={{ mb: 2 }}>
+                    <Box>
+                        <Typography variant="subtitle2" sx={{ mb: 1 }}>
