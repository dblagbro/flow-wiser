+                                    size="small"
+                                    color="primary"
+                                    variant="outlined"
+                                />
+                            )}
+                            {permissions.permissions?.maintain && (
+                                <Chip
+                                    icon={<IconCheck size={12} />}
+                                    label="Maintain"
+                                    size="small"
+                                    color="primary"
+                                    variant="outlined"
+                                />
