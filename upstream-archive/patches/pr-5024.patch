+    pendingRemoval?: boolean
 }
 
 export class SSEStreamer implements IServerSideEventStreamer {
     clients: { [id: string]: Client } = {}
+    activeMcpConnections: Set<string> = new Set()
 
     addExternalClient(chatId: string, res: Response) {
