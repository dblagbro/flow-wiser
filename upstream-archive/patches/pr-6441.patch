From 15931f4808ae1016555fe61466fb81724a8ee2e5 Mon Sep 17 00:00:00 2001
From: mvanhorn <mvanhorn@gmail.com>
Date: Sat, 1 Aug 2026 22:12:13 -0700
Subject: [PATCH 2/2] fix(ui): escape pipes in markdown table cells and stop
 shifting rows

A cell containing | broke the table structure, so escape it as \|. When a table
had no explicit header cells the serializer emitted an empty header row and
shifted every row down by one; treat the first row as the header instead, which
is the only shape markdown tables have.
---
 .../ui-component/dialog/ExpandRichInputDialog.jsx | 15 +++++++--------
 packages/ui/src/ui-component/input/RichInput.jsx  | 15 +++++++--------
 2 files changed, 14 insertions(+), 16 deletions(-)

diff --git a/packages/ui/src/ui-component/dialog/ExpandRichInputDialog.jsx b/packages/ui/src/ui-component/dialog/ExpandRichInputDialog.jsx
index 160a135a735..ce653371b61 100644
--- a/packages/ui/src/ui-component/dialog/ExpandRichInputDialog.jsx
+++ b/packages/ui/src/ui-component/dialog/ExpandRichInputDialog.jsx
@@ -32,14 +32,14 @@ const MarkdownTable = Table.extend({
     renderMarkdown: (node, h) => {
         const rows =
             node.content?.map((rowNode) =>
-                (rowNode.content || []).map((cellNode) => {
-                    const text = (cellNode.content || [])
+                (rowNode.content || []).map((cellNode) =>
+                    (cellNode.content || [])
                         .map((childNode) => h.renderChildren(childNode))
                         .join(' ')
                         .replace(/\s+/g, ' ')
                         .trim()
-                    return { text, isHeader: cellNode.type === 'tableHeader' }
-                })
+                        .replace(/\|/g, '\\|')
+                )
             ) || []
         const columnCount = rows.reduce((max, row) => Math.max(max, row.length), 0)
 
@@ -48,15 +48,14 @@ const MarkdownTable = Table.extend({
         const renderRow = (row = []) =>
             `| ${new Array(columnCount)
                 .fill(0)
-                .map((_, index) => row[index]?.text || '')
+                .map((_, index) => row[index] || '')
                 .join(' | ')} |`
 
         const headerRow = rows[0] || []
-        const hasHeader = headerRow.some((cell) => cell.isHeader)
-        const bodyRows = hasHeader ? rows.slice(1) : rows
+        const bodyRows = rows.slice(1)
 
         return [
-            renderRow(hasHeader ? headerRow : []),
+            renderRow(headerRow),
             `| ${new Array(columnCount).fill('---').join(' | ')} |`,
             ...bodyRows.map(renderRow)
         ].join('\n')
