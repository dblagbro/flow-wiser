+                new Promise<never>((_, reject) => {
+                    timeoutId = setTimeout(() => {
+                        void handle.kill().catch(() => {})
+                        reject(new Error(`Execution timed out after ${RUN_TIMEOUT_MS / 1000}s and was killed`))
+                    }, RUN_TIMEOUT_MS)
