+export const CLASSIFY_BRIDGE_FLAG_ENV = 'BEZZTY_FLOWISE_SENTINEL_CLASSIFY_BRIDGE'
+export const CLASSIFY_BRIDGE_TOKEN_ENV = 'BEZZTY_FLOWISE_SENTINEL_GATEWAY_TOKEN'
