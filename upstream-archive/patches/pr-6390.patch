+            settled = true
+            if (!raw) {
+                reject(httpError(400, 'invalid_json'))
+                return
+            }
+            try {
+                resolve(JSON.parse(raw))
+            } catch {
+                reject(httpError(400, 'invalid_json'))
+            }
+        })
+        req.on('error', () => {
+            if (!settled) {
+                settled = true
+                reject(httpError(400, 'invalid_json'))
+            }
