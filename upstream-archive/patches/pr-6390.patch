From b52e72af2d53c5ddd0f3a59b9688d5fecc33a9e2 Mon Sep 17 00:00:00 2001
From: fonminer <dwayne.bruyns@gmail.com>
Date: Mon, 25 May 2026 12:31:38 +0200
Subject: [PATCH 29/33] fix: run Husky hook through Corepack fallback

---
 .husky/pre-commit | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/.husky/pre-commit b/.husky/pre-commit
index 8e47731fc1c..ba7ec57026f 100755
--- a/.husky/pre-commit
+++ b/.husky/pre-commit
@@ -1,5 +1,13 @@
 #!/bin/sh
 . "$(dirname "$0")/_/husky.sh"
 
-pnpm quick # prettify
-pnpm lint-staged # eslint lint(also include prettify but prettify support more file extensions than eslint, so run prettify first)
+run_pnpm() {
+    if command -v pnpm >/dev/null 2>&1; then
+        pnpm "$@"
+    else
+        corepack pnpm "$@"
+    fi
+}
+
+run_pnpm quick # prettify
+run_pnpm lint-staged # eslint lint(also include prettify but prettify support more file extensions than eslint, so run prettify first)

