+        req.on('data', (chunk: string) => {
+            if (settled) return
+            size += Buffer.byteLength(chunk)
+            if (size > COCKPIT_BODY_LIMIT_BYTES) {
+                settled = true
+                reject(httpError(413, 'body_too_large'))
+                req.destroy()
+                return
+            }
+            raw += chunk
+        })
