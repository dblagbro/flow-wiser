+            omitMetadataKeys = _omitMetadataKeys.split(',').map((key) => key.trim())
+        }
+
+        // Parse comma-separated locales
+        const locales = localeInput
+            .split(',')
+            .map((loc) => loc.trim())
+            .filter((loc) => loc.length > 0)
+
+        // Ensure at least one locale
