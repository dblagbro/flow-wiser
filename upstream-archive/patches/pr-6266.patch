From b22832c8d412852b5847c7b0e191bd4816077ed7 Mon Sep 17 00:00:00 2001
From: Weichen Xu <weichen.xu@databricks.com>
Date: Wed, 22 Apr 2026 19:02:03 +0800
Subject: [PATCH 02/10] update

Signed-off-by: Weichen Xu <weichen.xu@databricks.com>
---
 .../credentials/MLflowApi.credential.ts       | 49 +++++++++++++++++++
 packages/ui/src/assets/images/mlflow.svg      |  1 +
 .../src/ui-component/extended/AnalyseFlow.jsx | 29 +++++++++++
 3 files changed, 79 insertions(+)
 create mode 100644 packages/components/credentials/MLflowApi.credential.ts
 create mode 100644 packages/ui/src/assets/images/mlflow.svg

diff --git a/packages/components/credentials/MLflowApi.credential.ts b/packages/components/credentials/MLflowApi.credential.ts
new file mode 100644
index 00000000000..539c668d6ac
--- /dev/null
+++ b/packages/components/credentials/MLflowApi.credential.ts
@@ -0,0 +1,49 @@
+import { INodeParams, INodeCredential } from '../src/Interface'
+
+class MLflowApi implements INodeCredential {
+    label: string
+    name: string
+    version: number
+    description: string
+    inputs: INodeParams[]
+
+    constructor() {
+        this.label = 'MLflow API'
+        this.name = 'mlflowApi'
+        this.version = 1.0
+        this.description =
+            'Connect to an MLflow tracking server. For Databricks, set Tracking URI to "databricks" and provide a personal access token.'
+        this.inputs = [
+            {
+                label: 'Tracking URI',
+                name: 'mlflowTrackingUri',
+                type: 'string',
+                default: 'http://localhost:5000',
+                placeholder: 'http://localhost:5000'
+            },
+            {
+                label: 'Token',
+                name: 'mlflowToken',
+                type: 'password',
+                optional: true,
+                description: 'Bearer token for OSS MLflow or Databricks personal access token'
