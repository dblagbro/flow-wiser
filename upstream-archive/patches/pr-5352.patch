From 5d1462c19c64190c016dffc10bf834940ae22c1f Mon Sep 17 00:00:00 2001
From: Iokin Pardo <iokinpardo@users.noreply.github.com>
Date: Wed, 15 Oct 2025 00:30:42 +0200
Subject: [PATCH 05/18] Add credential binding metadata to workspace exports

---
 docs/credential-export-options.md             |  21 ++
 .../src/services/export-import/index.ts       | 308 ++++++++++++++++++
 packages/ui/src/utils/genericHelper.js        |   6 +
 3 files changed, 335 insertions(+)
