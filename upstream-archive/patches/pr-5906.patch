Subject: [PATCH 2/4] Update packages/components/src/utils.ts

Co-authored-by: Copilot <175728472+Copilot@users.noreply.github.com>
---
 packages/components/src/utils.ts | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/packages/components/src/utils.ts b/packages/components/src/utils.ts
index 6d3d776378b..e73741f745b 100644
--- a/packages/components/src/utils.ts
+++ b/packages/components/src/utils.ts
@@ -124,10 +124,12 @@ const defaultAllowExternalDependencies = ['axios', 'moment', 'node-fetch']
 
 export const defaultAllowBuiltInDep = ['assert', 'buffer', 'crypto', 'events', 'path', 'querystring', 'timers', 'url', 'zlib']
 
-export function safeJsonParse(input: string) {
-    if (!input || input.trim() === '') return null
+export function safeJsonParse(input: unknown) {
+    if (typeof input !== 'string') return null
+    const trimmed = input.trim()
+    if (!trimmed) return null
     try {
-        return JSON.parse(input)
+        return JSON.parse(trimmed)
     } catch {
         return null
     }

