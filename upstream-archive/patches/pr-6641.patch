             return [
                 new Document({
                     pageContent: JSON.stringify(data ?? {}),
-                    metadata: { ...(this.additionalMetadata || {}), source: this.keyword, type: 'serp' }
+                    metadata: { source: this.keyword, type: 'serp' }
                 })
             ]
         }
