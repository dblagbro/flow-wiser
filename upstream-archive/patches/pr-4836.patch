 .../nodes/vectorstores/Postgres/Postgres.ts   | 10 ++++-
 .../vectorstores/Postgres/driver/Base.ts      |  4 +-
 .../vectorstores/Postgres/driver/TypeORM.ts   |  7 ++--
 4 files changed, 43 insertions(+), 18 deletions(-)

