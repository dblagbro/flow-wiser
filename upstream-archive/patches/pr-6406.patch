         "eslint": "^8.24.0",
@@ -67,8 +67,26 @@
     },
     "pnpm": {
         "onlyBuiltDependencies": [
+            "@swc/core",
+            "bufferutil",
+            "canvas",
+            "core-js",
+            "core-js-pure",
+            "couchbase",
+            "cpu-features",
+            "cypress",
+            "es5-ext",
+            "esbuild",
             "faiss-node",
-            "sqlite3"
+            "grpc-tools",
+            "msgpackr-extract",
+            "protobufjs",
