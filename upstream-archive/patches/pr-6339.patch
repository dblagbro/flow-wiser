+    })
+
+    it('returns a LocalBackend rooted under <SANDBOX_LOCAL_PATH>/<scope> when SANDBOX_TYPE=local', async () => {
+        const tmp = mkdtempSync(join(tmpdir(), 'flowise-factory-'))
