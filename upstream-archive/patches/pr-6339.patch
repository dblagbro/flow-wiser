+        const def = new StateBackend({
+            '/foobar/x.md': { content: 'def', mimeType: 'text/markdown', created_at: 0, modified_at: 0 }
+        })
+        const inner = new StateBackend({
+            '/x.md': { content: 'inner', mimeType: 'text/markdown', created_at: 0, modified_at: 0 }
