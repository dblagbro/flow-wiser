{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Read|Edit|Write|NotebookEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-protected-paths.sh",
                        "timeout": 5
                    }
                ]
            }
        ]
    }
}
