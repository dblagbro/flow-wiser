# Flow-Wiser — secret, container and shell scanning.
#
# ============================================================================
# DISABLED ON PURPOSE — do not rename to .yml until verified.
# ============================================================================
#
# This workflow is written and ready, but it is NOT enabled, because none of the
# scanners it calls are installed on the machine where it was authored. It has
# therefore never been observed to fail on a known-bad input or pass on a
# known-good one.
#
# Enabling an unverified gate is precisely the failure recorded in
# docs/PROCESS-GAPS.md G1 — controls that were written and documented but never
# observed to execute, whose existence was taken as evidence of their operation.
# A gate that has only ever been assumed to work is worse than no gate, because
# it manufactures false confidence.
#
# TO ENABLE (tracked as RM-09 in docs/remediation-plan.md):
#   1. Install the scanners locally: gitleaks, hadolint, shellcheck, trivy.
#   2. Verify EACH ONE on a known-bad input — confirm it FAILS. For example,
#      commit a dummy AWS-shaped key to a scratch branch and confirm gitleaks
#      rejects it. Then delete the scratch branch.
#   3. Verify EACH ONE on a known-good input — confirm it PASSES on this tree.
#   4. Only then: git mv security-scan.yml.disabled security-scan.yml
#   5. Record the verification in docs/PROCESS-GAPS.md.
#
# Both halves are required. See docs/decisions/ADR-0003-agentic-methodology.md.

name: Security scan

on:
  push:
    branches: ['**']
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  secrets:
    name: Secret scan
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0 # full history — a secret committed and later removed is still leaked

      - name: gitleaks
        uses: gitleaks/gitleaks-action@v2
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

      - name: Assert no credential exports or databases are tracked
        run: |
          set -euo pipefail
          BAD=$(git ls-files \
            | grep -iE 'credentials-backup|\.sqlite3?$|\.env$|\.pem$|\.p12$|id_rsa|service-account.*\.json' \
            || true)
          if [ -n "$BAD" ]; then
            echo "::error::Secret-shaped files are tracked in git:"
            echo "$BAD" | sed 's/^/  /'
            exit 1
          fi
          echo "No secret-shaped files tracked."

  containers:
    name: Container hygiene
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: hadolint
        uses: hadolint/hadolint-action@v3.1.0
        with:
          dockerfile: docker/Dockerfile
          failure-threshold: error

      - name: Assert the version pin assertion is still present
        # Guards the defect this project was founded on: an unpinned install froze
        # the layer cache and shipped three mislabelled images. The assertion that
        # installed == requested must never be removed.
        run: |
          set -euo pipefail
          if ! grep -q 'FLOWISE_VERSION' docker/Dockerfile; then
            echo "::error::docker/Dockerfile no longer pins FLOWISE_VERSION as a build arg."
            exit 1
          fi
          if ! grep -qi 'exit 1' docker/Dockerfile; then
            echo "::error::docker/Dockerfile has no failing version assertion."
            exit 1
          fi
          echo "Version pinning and assertion present."

      - name: Assert the archive is excluded from images
        run: |
          set -euo pipefail
          grep -q 'upstream-archive' .dockerignore \
            || { echo "::error::.dockerignore must exclude upstream-archive/"; exit 1; }
          echo "upstream-archive excluded."

  shell:
    name: Shell scripts
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: shellcheck
        run: |
          sudo apt-get update -qq && sudo apt-get install -y -qq shellcheck
          find .githooks .husky scripts -type f \( -name '*.sh' -o -name 'pre-*' \) -print0 2>/dev/null \
            | xargs -0 -r shellcheck --severity=error
